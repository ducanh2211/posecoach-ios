        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang đo góc mở ống kính và độ to của đầu so với chân…"
          }
        }
      }
    },
    "sheet_high_unknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app isn't sure about this photo (the feet aren't clearly visible or the lens type is unclear), so please choose. Compare the head size to the feet."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "App chưa đủ chắc với ảnh này (không thấy rõ chân hoặc ống kính không rõ kiểu), cần bạn chọn. Nhìn độ to của đầu so với chân."
          }
        }
      }
    },
