    "skip_crop": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "a close-up portrait has no arm or leg joints to check for awkward crops"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "ảnh chân dung cận không có khớp tay chân nào để xét cắt cụt"
          }
        }
      }
    },
    "skip_elevation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "the person in the template is far from the center or the reference points aren't visible, so the phone height can't be inferred"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "người trong ảnh mẫu nằm lệch xa giữa khung hoặc không thấy mốc đo, nên không suy được máy cao hay thấp"
          }
        }
      }
    },
    "skip_no_angle_label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "the template has no camera angle label (high / eye level / low)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "ảnh mẫu chưa gắn nhãn góc máy (trên cao / ngang tầm / dưới thấp)"
          }
        }
      }
    },
    "skip_perspective_closeup": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "the template is a close-up, so the app can't check zoom by itself — feel free to zoom, but look at the template to decide whether to stand close or stand back and zoom"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "ảnh mẫu là ảnh cận nên app không tự kiểm được zoom — bạn được zoom thoải mái, nhưng hãy nhìn ảnh mẫu để tự chọn đứng gần hay đứng xa rồi zoom"
          }
        }
      }
    },
    "skip_perspective_no_legs": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "the hips and legs aren't clearly visible in the template, so its perspective can't be inferred"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "không thấy rõ hông và chân trong ảnh mẫu nên không suy được độ méo phối cảnh"
          }
        }
      }
    },
    "skip_perspective_steep": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "the template was shot from high above or low below — the angle stretches the body just like standing close, so distance can't be separated. The app offers both options: walk or zoom"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "ảnh mẫu chụp từ trên cao hoặc dưới thấp — góc máy làm thân/chân co giãn y như đứng gần, không tách được khoảng cách. App đưa cả hai lựa chọn: đi bộ hoặc zoom"
          }
        }
      }
    },
    "skip_pitch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "not enough reference points to infer the template's perspective (needs the legs, or a clear face and both shoulders)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "không đủ mốc để suy độ méo phối cảnh của ảnh mẫu (cần thấy chân, hoặc thấy rõ mặt và hai vai)"
          }
        }
      }
    },
    "skip_pose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "no joints could be measured in the template"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "không đo được khớp nào trong ảnh mẫu"
          }
        }
      }
    },
    "skip_roll": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "the shoulders (and hips) aren't fully visible in the template, so its tilt is unknown"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "không thấy đủ vai (và hông) trong ảnh mẫu nên không biết ảnh có nghiêng không"
          }
        }
      }
    },
    "skip_scale": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "couldn't measure %1$@ in the template, so the right distance is unknown"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "không đo được %1$@ trong ảnh mẫu nên không biết nên đứng xa hay gần"
          }
        }
      }
    },
    "skip_yaw": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "both shoulders aren't clearly visible in the template, so the model's direction is unknown"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "không thấy rõ hai vai trong ảnh mẫu nên không biết mẫu quay hướng nào"
          }
        }
      }
    },
    "steps_a_little": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "a little"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "một chút"
          }
        }
      }
    },
    "steps_a_lot": {
      "extractionState": "manual",
      "localizations": {
