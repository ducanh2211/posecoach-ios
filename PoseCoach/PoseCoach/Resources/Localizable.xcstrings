    "angle_opt_high_hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Top of the head or the floor visible · chin hides most of the neck · eyes look up at the camera"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thấy đỉnh đầu hoặc sàn nhà · cằm che gần hết cổ · mắt ngước lên nhìn máy"
          }
        }
      }
    },
    "angle_opt_level": {
