    "angle_opt_low_hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceiling or sky visible · underside of the chin visible · eyes glance down at the camera"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thấy trần nhà hoặc bầu trời · thấy dưới cằm · mắt liếc xuống nhìn máy"
          }
        }
      }
    },
