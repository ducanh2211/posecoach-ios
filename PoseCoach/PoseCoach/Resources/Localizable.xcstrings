    "camera_err_no_live_detection": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phone can't run detection while recording. You can still record, and the app will score the clip afterwards."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy này không chạy được nhận diện trong lúc quay. Vẫn quay được, và app sẽ chấm điểm sau khi quay xong."
          }
        }
      }
    },
    "camera_err_not_ready": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera isn't ready to record"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera chưa sẵn sàng để quay"
          }
        }
      }
    },
    "camera_err_open": {
