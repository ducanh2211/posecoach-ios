    "sheet_angle_measured": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measured from the background: %1$@. Pre-selected — change it if it looks wrong, especially for stairs or shots pointing almost straight down at the floor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "App đo từ nền ảnh: %1$@. Đã chọn sẵn — đổi nếu thấy sai, nhất là ảnh chụp cầu thang hoặc chúc gần như thẳng xuống sàn."
          }
        }
      }
    },
    "sheet_angle_unknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app couldn't measure the camera angle from this photo. Please choose one so it can guide raising/lowering and tilting the phone correctly. Use the hints under each option."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "App chưa đo được góc máy từ ảnh này, cần bạn chọn để hướng dẫn đúng việc nâng/hạ và chúc/hất máy. Nhìn ảnh theo gợi ý dưới mỗi mục."
          }
        }
      }
    },
    "sheet_auto_detected": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Detected automatically: %1$@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "App đã tự nhận: %1$@"
          }
        }
      }
    },
    "sheet_high_guess": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This photo looks like \"%1$@\" (from the lens field of view and head-to-feet size). Pre-selected — change it if it looks wrong."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "App đo được ảnh này giống kiểu \"%1$@\" (góc mở ống kính và đầu so với chân). Đã chọn sẵn — đổi nếu thấy sai."
          }
        }
      }
    },
    "sheet_high_measuring": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measuring the lens field of view and the head size relative to the feet…"
