    "gate_tell_model_feet": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand (or sit) in the base position, then KEEP YOUR FEET STILL — don't kick a leg out or step toward the camera."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đứng (hoặc ngồi) đúng tư thế nền, rồi GIỮ YÊN CHÂN — khoan đá chân hay bước về phía máy."
          }
        }
      }
    },
    "gate_tell_model_wait": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wait until the photographer has set the angle and says so before posing. Arm poses can be done any time."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đợi người chụp canh xong góc, có báo rồi mới vào dáng. Dáng tay thì làm lúc nào cũng được."
          }
        }
      }
