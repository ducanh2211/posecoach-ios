          }
        }
      }
    },
    "tripod_hold_still": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold the phone still…"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ yên máy…"
          }
        }
      }
    },
    "tripod_roll_ccw": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set up: rotate the phone slightly counter-clockwise to level it"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt máy: xoay nhẹ ngược chiều kim đồng hồ cho thẳng"
          }
        }
      }
    },
    "tripod_roll_cw": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set up: rotate the phone slightly clockwise to level it"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt máy: xoay nhẹ theo chiều kim đồng hồ cho thẳng"
          }
        }
      }
    },
    "tripod_step_into_frame": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Phone is set — now step back into the frame"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy đã đặt xong — giờ lùi ra, đứng vào khung"
          }
        }
      }
    },
    "tripod_tilt_down": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set up: tilt the phone down a little more"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt máy: chúc máy xuống thêm một chút"
          }
        }
      }
    },
    "tripod_tilt_up": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set up: tilt the phone up a little more"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt máy: ngửa máy lên thêm một chút"
          }
        }
      }
    },
    "warn_leg_toward_lens": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The template has a leg pointing toward the lens — the app will skip the zoom check, and this pose is hard to coach by voice."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ảnh mẫu có chân chĩa về phía ống kính — app sẽ bỏ qua tiêu chí zoom, và dáng này khó hướng dẫn cho mẫu làm theo bằng lời."
          }
        }
      }
    },
    "warn_no_hips": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hips aren't clearly visible — the app will measure size from the face instead of body height."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thấy rõ hông — app sẽ đo tỉ lệ bằng khung mặt thay vì chiều cao thân."
          }
        }
      }
    },
    "warn_no_shoulders": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both shoulders aren't clearly visible — the app will measure using the face. Criteria that need the shoulders (phone level, tilt from the body) will be skipped."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thấy rõ hai vai — app sẽ đo bằng khuôn mặt. Các mục cần vai (độ nghiêng máy, ngửa/chúc theo thân) sẽ bị bỏ qua."
          }
        }
      }
    },
    "warn_portrait_no_face": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A portrait without a clearly visible face — the app will skip the distance and phone height criteria."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ảnh chân dung nhưng không thấy rõ mặt — app sẽ bỏ qua tiêu chí xa/gần và máy cao/thấp."
          }
        }
      }
    },
    "warn_spine_tilt": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The body is tilted about %1$lld° from vertical — the model may be leaning, or the photo was taken from high above or low below. If the model is sitting or lying down, guidance won't be accurate."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trục thân nghiêng khoảng %1$lld° so với phương thẳng đứng — có thể do mẫu đang tựa, hoặc do ảnh chụp từ trên cao/dưới thấp. Nếu mẫu đang ngồi hoặc nằm thì hướng dẫn sẽ không chính xác."
          }
        }
      }
    },
    "library_delete_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld photo will be permanently deleted and can't be recovered."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld photos will be permanently deleted and can't be recovered."
                }
              }
            }
          }
        },
        "vi": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld ảnh sẽ bị xoá hẳn, không lấy lại được."
                }
              }
            }
          }
        }
      }
    },
