    },
    "action_pick_other": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick another photo"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn ảnh khác"
          }
        }
      }
    },
    "advice_center": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move the phone sideways so the model is in the same spot as in the template."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dịch máy sang ngang cho mẫu vào đúng vị trí như trong ảnh mẫu."
          }
        }
      }
    },
    "advice_crop": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The frame edge cuts right at a wrist/elbow/knee/ankle, making the limb look chopped off. Step back a little or reframe so the edge falls between two joints."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mép khung đang cắt đúng vào cổ tay/khuỷu/gối/cổ chân, làm chi trông như bị cụt. Lùi ra một chút hoặc chỉnh khung cho cắt vào khoảng giữa hai khớp."
          }
        }
      }
    },
    "advice_distance": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're at the wrong distance. Move closer or step back so the model fills the same part of the frame as in the template."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đứng sai khoảng cách. Tiến lại gần hoặc lùi ra xa cho mẫu chiếm đúng phần khung như ảnh mẫu."
          }
        }
      }
    },
    "advice_elevation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Raise or lower the phone to match the template's viewing angle."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nâng máy lên hoặc hạ xuống cho khớp góc nhìn của ảnh mẫu."
          }
        }
      }
    },
    "advice_eyes_open": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The model's eyes are closed in every frame. Tell them to look at the camera and keep their eyes open."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mẫu đang nhắm mắt ở mọi khung hình. Bảo mẫu nhìn thẳng và giữ mắt mở."
          }
        }
      }
    },
    "advice_pitch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The phone's tilt doesn't match the template. Tilt the phone down or up until the head-to-feet proportions look like the template."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Độ nghiêng của máy chưa khớp ảnh mẫu. Chúc máy xuống hoặc hất lên cho tới khi tỉ lệ đầu-chân trông giống ảnh mẫu."
          }
        }
      }
    },
    "advice_pose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tell the model to match the arms and legs in the template."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bảo mẫu để tay chân giống ảnh mẫu."
          }
        }
      }
    },
    "advice_sharpness": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tell the model to hold stiller — every frame is blurred by movement."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bảo mẫu đứng yên hơn — mọi khung đều bị nhoè do cử động."
          }
        }
      }
    },
    "advice_yaw": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠ FIX THIS FIRST. Tell the model to turn to match the direction in the template. If the direction is wrong, getting everything else right won't help — standing in the right spot can't make up for it."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠ SỬA CÁI NÀY TRƯỚC. Bảo mẫu xoay người cho giống hướng trong ảnh mẫu. Sai hướng thì mọi thứ khác đúng cũng vô ích — không có cách nào cứu bằng việc đứng đúng chỗ."
          }
        }
      }
    },
    "analyzing_template_image": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Template being analyzed"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ảnh mẫu đang phân tích"
          }
        }
      }
    },
