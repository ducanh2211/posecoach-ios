# Uncomment the next line to define a global platform for your project
platform :ios, '17.0'

target 'PoseCoach' do
  # Comment the next line if you don't want to use dynamic frameworks
  use_frameworks!

  # Nhận diện khung xương — CÙNG VERSION với Android (libs.versions.toml: mediapipeTasksVision = "1.0.0").
  # Không dùng SPM: SPM chỉ có từ 1.1.0, và buộc ghim theo commit vì unsafeFlags.
  pod 'MediaPipeTasksVision', '1.0.0'

  # Cùng engine nhận diện mặt và nhãn ảnh với Android.
  pod 'GoogleMLKit/FaceDetection', '8.0.0'
  pod 'GoogleMLKit/ImageLabeling', '8.0.0'
  pod 'onnxruntime-objc', '1.30.0'

  target 'PoseCoachTests' do
    inherit! :search_paths
    # Pods for testing
  end

  target 'PoseCoachUITests' do
    # Pods for testing
  end

end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '17.0'
    end
  end

  # Test bundle chạy BÊN TRONG app (TEST_HOST) → thư viện đã có sẵn trong app, không được link lần nữa.
  # MediaPipe ép `-force_load libMediaPipeTasksCommon_*_graph.a` vào MỌI target dùng pod, kể cả test:
  # link 2 lần thì calculator đăng ký 2 lần → crash "FlowLimiterCalculator already registered".
  # Giữ search path (để `import` biên dịch được), bỏ cờ link; symbol lấy từ app qua BUNDLE_LOADER.
  installer.aggregate_targets.select { |t| t.name == 'Pods-PoseCoachTests' }.each do |t|
    t.user_build_configurations.each_key do |config_name|
      path = t.xcconfig_path(config_name)
      lines = File.readlines(path).reject { |l| l.start_with?('OTHER_LDFLAGS') }
      File.write(path, lines.join + "OTHER_LDFLAGS = $(inherited)\n")
    end
  end
end
